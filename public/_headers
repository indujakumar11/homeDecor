# Security headers for the static site (Cloudflare Workers static assets).
# Vite copies this file into dist/, where wrangler.jsonc serves it.
#
# The CSP is REPORT-ONLY for now: violations are logged in the browser
# console but nothing is blocked. Switch the header name to
# Content-Security-Policy only after checking every page and admin flow.
#
# CSP notes:
# - script-src hashes: the inline Home hero-preload <script> in index.html,
#   and (via 'unsafe-hashes') the Google Fonts loader's onload="this.media='all'".
#   Update the first hash whenever that inline script changes.
# - connect-src / img-src: Supabase (data + auth) and the image/upload Worker.
# - img-src data: (CSS, MFA QR code) and blob: (admin upload preview).
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-aZf99YEHWdvDKLKuPPgC9+OsH22wOZQ3lrmSyNg4dOM=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://homedecor-worker-production.homedecor-blackshade.workers.dev; connect-src 'self' https://kmuomlwrolehqxqvacwq.supabase.co https://homedecor-worker-production.homedecor-blackshade.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
