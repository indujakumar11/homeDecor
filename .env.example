VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Cloudflare Worker (see worker/) — defaults to http://localhost:8787
# if unset. Only ever points at a local dev Worker; there is no production
# value for this yet.
VITE_WORKER_URL=

# WhatsApp number for the floating "Chat on WhatsApp" button: country code +
# number, digits only (no "+", spaces, hyphens or brackets), e.g. 91XXXXXXXXXX.
# Leave empty to hide the button. Restart the dev server after changing it.
VITE_WHATSAPP_NUMBER=
